# --- Infraestructura ---
# PG_PASSWORD la exige docker-compose para crear la base; PG_DSN tiene que
# llevar LA MISMA contraseña. Host `db` y `cache`: nombres de servicio.
PG_PASSWORD=CAMBIA_ESTO
PG_DSN=postgresql://qf:CAMBIA_ESTO@db:5432/quantfut
REDIS_URL=redis://cache:6379/0

# --- APIs ---
ODDS_API_KEY=
# Solo `eu`: trae Pinnacle y Betfair Exchange. 3 créditos/llamada, ~5.800/mes.
ODDS_API_REGIONS=eu
ODDS_API_MARKETS=h2h,totals,spreads
API_FOOTBALL_KEY=
# Límites del plan de API-Football (Free: 10/min, 100/día).
API_FOOTBALL_RPM=10
API_FOOTBALL_DAILY=100

# --- Telegram ---
TG_BOT_TOKEN=
TG_CHANNEL_FREE=@tu_canal_gratis
TG_CHANNEL_PAID=-1001234567890
TG_ALERT_CHAT=123456789

# --- Cadena de hashes ---
CHAIN_DIR=/srv/quantfut/chain
CHAIN_GIT_REMOTE=git@github.com:tuusuario/quantfut-registro-publico.git

# --- Modelo ---
MODEL_VERSION=0.1.0
FS_VERSION=fs-0.1.0
ARTIFACT_DIR=/srv/quantfut/artifacts
DECAY_HALFLIFE_DAYS=180
XG_BLEND=0.65

# --- Riesgo ---
EDGE_SHRINKAGE=0.55
MIN_EDGE_PCT=3.0
KELLY_FRACTION=0.20
MAX_STAKE_UNITS=2.0
MAX_PICKS_PER_DAY=12
SHARP_BOOK=pinnacle
DEVIG_METHOD=shin
# 0 hasta que el criterio de selección nuevo supere la puerta de CLV.
PUBLISH_PICKS_ENABLED=0
# Línea de alta probabilidad (0 = apagada)
ALTA_PROB_ENABLED=0
# Ampliación 62-95 % (alta_prob_ext, db/057); exige LOTE_ALTA_EXT_DESDE en hashchain
ALTA_PROB_EXT_ENABLED=0
# ALTA_PROB_CONTROL_DESDE=2026-10-06
# Criterio de picks: casas donde apuestan los suscriptores (nombres de
# publish/picks.canonical_book), edge bruto mínimo contra Pinnacle en % y
# antigüedad máxima del precio en horas.
SOFT_BOOKS=bet365,betano,1xbet,william_hill,888sport,betway
SOFT_MIN_EDGE_PCT=2.0
SOFT_QUOTE_MAX_AGE_HOURS=6

# --- Grafana (panel de operación privado) ---
DOMAIN=tudominio.com
GRAFANA_USER=admin
GRAFANA_PASSWORD=
GRAFANA_DB_PASSWORD=

# --- Caddy (ver Caddyfile) ---
# panel.$DOMAIN, /control y /admin no se abren por IP: los protege
# Cloudflare Access, y Caddy responde 404 si falta Cf-Access-Jwt-Assertion.

# --- Auth de la API interna ---
ADMIN_TOKEN=
ADMIN_CONSOLE_USER=
ADMIN_CONSOLE_PASSWORD_HASH=
# OBLIGATORIO para que tu backend de frontend acceda a los picks/predicciones
# completos (rutas /v1/*). Sin él, esas rutas responden 404 siempre (fallo
# cerrado). Es el ÚNICO secreto que debe conocer tu backend de frontend — NUNCA
# lo mandes al navegador ni lo embebas en la app Flutter: ambos son clientes
# que corren en el dispositivo del usuario y cualquier secreto ahí dentro se
# puede extraer. Genera uno con
# `python -c "import secrets; print(secrets.token_hex(32))"`.
SERVICE_TOKEN=
RATE_LIMIT_DEFAULT_PER_MINUTE=60
# Cuentas de clientes (/app/v1, web y app Flutter). Apagado = 503 en todas
# sus rutas: ponlo a 1 cuando decidas abrir altas. Requiere db/043.
ACCOUNTS_ENABLED=0

# --- Correo (Proton Mail): verificación y restablecimiento de contraseña ---
# Opción A, recomendada: envío SMTP oficial de Proton. Plan de pago + dominio
# propio verificado en Proton (SPF/DKIM/DMARC). El token se crea en
# Ajustes > IMAP/SMTP > Tokens SMTP, ligado a una dirección del dominio.
#   SMTP_HOST=smtp.protonmail.ch  SMTP_PORT=587  SMTP_SECURITY=starttls
#   SMTP_USERNAME=no-responder@tudominio.com  SMTP_PASSWORD=<token SMTP>
# Opción B: Proton Mail Bridge (servicio protonmail-bridge, perfil
# proton-bridge). Usuario y contraseña salen de `info` dentro del bridge.
#   SMTP_HOST=protonmail-bridge  SMTP_PORT=25  SMTP_SECURITY=starttls
#   SMTP_TLS_VERIFY=0   (certificado autofirmado, solo red interna)
# Sin SMTP_HOST no se envía nada: el panel lo marca como "Correo sin configurar".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_TLS_VERIFY=1
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=QuantFut
# Base de los enlaces de los correos. Por defecto https://$DOMAIN.
PUBLIC_BASE_URL=
# "development" habilita el origen CORS de Vite (localhost:5173). Cualquier
# otro valor (el default) lo deja fuera, como corresponde en producción.
APP_ENV=production

# Firebase: credencial privada montada solo en el backend, nunca en Flutter.
FIREBASE_PROJECT_ID=pronosticos-deportivos-85ffa
FIREBASE_AUTH_ENABLED=0
FIREBASE_APPCHECK_ENFORCE=0
GOOGLE_APPLICATION_CREDENTIALS=

# Clave maestra (AES-256) que cifra las secret keys guardadas desde /control/recompensas.
# Genera una con: python -m qf.comercial.cifrado   (no la guardes en la base de datos)
# Para rotarla: pon la nueva aqui y la anterior en QF_SECRETS_KEY_OLD.
QF_SECRETS_KEY=
QF_SECRETS_KEY_OLD=

PITCHAPI_KEY=
