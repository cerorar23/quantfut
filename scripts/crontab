SHELL=/bin/sh
# 2026-10-25: las tareas de API-Football, FotMob, PitchAPI y worldfootball/FBref quedan comentadas
# con «RETIRADO»; para volver atrás basta quitar ese prefijo. FotMob (captura y sedes) se reactivó el
# mismo día por orden del titular, como complemento diario.
PYTHONPATH=/app/src
# En python:3.12-slim el intérprete está en /usr/local/bin y el PATH por
# defecto de cron es /usr/bin:/bin: sin esta línea cada job acababa en
# "python: not found". Las claves y ajustes llegan por pam_env desde
# /etc/environment (lo escribe el worker de docker-compose al arrancar).
PATH=/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin

# --- FASE 0 ---
# Captura de cuotas cada 10 min. EL PROCESO MAS IMPORTANTE DEL SISTEMA.
*/10 * * * * cd /app && python -m qf.ingest.odds_worker >> /var/log/odds.log 2>&1
# Rescate del cierre, desfasado 5 min: la ventana `close` (3-12 min antes)
# caía en UNA sola pasada; si fallaba, la oferta quedaba sin cierre justo. Solo
# mira `close` y no gasta créditos si la pasada principal ya lo capturó.
5-59/10 * * * * cd /app && python -m qf.ingest.odds_worker --solo-cierre >> /var/log/odds.log 2>&1
# Cierres de PropLine (`/odds/closing`, ya archivados por el recolector a las :07, >= 6 h tras el saque) como
# `close`: CLV, sombra y entrenamiento. Sin peticiones. La liquidación espera al cierre hasta 48 h.
40 */3 * * * cd /app && flock -n /tmp/propline_cierres.lock python -m qf.ingest.propline_cierres >> /var/log/propline_cierres.log 2>&1
# Ráfagas para medir la latencia de las casas blandas (db/038), con tope de créditos
# Respaldo de cuotas NBA/tenis tras el sellado: no hace nada si CUOTAS_RESPALDO_AUTO != 1 y, sin huecos, 0 peticiones.
7-57/10 * * * * cd /app && flock -n /tmp/cuotas_respaldo.lock python -m qf.ingest.cuotas_respaldo --auto >> /var/log/cuotas_respaldo.log 2>&1

*/5 * * * * cd /app && python -m qf.ingest.rafagas >> /var/log/rafagas.log 2>&1

# Sombra del criterio de picks: registra lo que se HABRÍA recomendado con las
# cuotas recién capturadas. No publica. Se liquida desde qf.eval.clv.
25 * * * * cd /app && python -m qf.publish.shadow_sharp capture >> /var/log/shadow_sharp.log 2>&1

# --- FASE 1 ---
# Calendario de partidos futuros. Dos veces al dia (capta reprogramaciones).
15 5,17 * * * cd /app && python -m qf.ingest.fixtures >> /var/log/fixtures.log 2>&1

# Clasificacion de cada liga para las fichas de la web, calculada con nuestros
# resultados cerrados (sin peticiones). Cada hora, tras los cierres.
50 * * * * cd /app && python -m qf.ingest.standings >> /var/log/standings.log 2>&1

# Marcador en juego para la app (db/056) desde el listado diario de FotMob: UNA peticion
# por pasada y solo si hay algun partido en ventana. Respeta el enfriamiento de 12 h de FotMob.
# Al pitido final cierra el partido con su pagina de FotMob (una peticion por partido terminado) y liquida.
*/5 * * * * cd /app && python -m qf.ingest.live >> /var/log/live.log 2>&1

# Cierre de partidos terminados + liquidacion encadenada. Cada 3 horas.
# Lee el archivo de PropLine (/scores cada 3 h, a las :07).
45 */3 * * * cd /app && python -m qf.ingest.results >> /var/log/results.log 2>&1

# Bajas y once desde FotMob (31-oct-2026): copia lo que `fotmob_captura previos` (cada 5 min) guarda a lineups,
# lineups_previstas e injuries, 2 minutos después de cada captura.
2-59/5 * * * * cd /app && flock -n /tmp/fotmob_alineaciones.lock python -m qf.ingest.fotmob_alineaciones >> /var/log/fotmob_alineaciones.log 2>&1

# Testigo de calendario y resultados con football-data.org (solo avisa, nunca escribe en `matches`).
10 1,13 * * * cd /app && python -m qf.ingest.fdorg_respaldo >> /var/log/fdorg.log 2>&1

# Chequeo de salud. Diario, alerta si algo falla.
0 7 * * * cd /app && python -m qf.ingest.health >> /var/log/health.log 2>&1

# --- FASE 4 ---
# Un minuto después, evalúa el ajuste de XI en sombra. No publica ni apuesta;
# si todavía no hay muestra/artefacto validado termina como no-op.
1-56/5 * * * * cd /app && python -m qf.model.shadow >> /var/log/shadow.log 2>&1

# --- FASE 3 ---
# Job diario: predecir, seleccionar picks, sellar cadena, publicar. 13:00 UTC = 07:00 en
# Ciudad de México, siempre (México no tiene horario de verano desde 2022; cron corre en
# UTC). Decisión del usuario, 2026-10-12: antes era 08:00 UTC (02:00 en México). Solo entran
# partidos que empiezan DESPUÉS del sellado: los de 08:00-13:00 UTC dependen del lote anterior.
0 9 * * * cd /app && python -m qf.publish.daily >> /var/log/daily.log 2>&1

# F7: sello tardio por partido (T-45 o alineaciones confirmadas). Sin efecto mientras hashchain.LOTE_POR_PARTIDO_DESDE sea None.
*/5 * * * * cd /app && flock -n /tmp/sello_tardio.lock python -m qf.publish.sello_tardio >> /var/log/sello_tardio.log 2>&1

# F7: estado de fuerzas y onces habituales del ajuste del once (se reconstruye en ~2 min; el job de sello solo lo lee).
12 * * * * cd /app && flock -n /tmp/estado_xi.lock python -m qf.model.ajuste_xi --estado >> /var/log/estado_xi.log 2>&1

# Ajuste del once en sombra: mide hacia adelante cada dia y avisa una sola vez al llegar a 150 partidos con efecto.
30 7 * * * cd /app && python -m qf.model.ajuste_xi --medir --avisar >> /var/log/ajuste_xi.log 2>&1

# Liquidacion y CLV de respaldo (results.py ya la encadena).
30 2,10,18 * * * cd /app && python -m qf.eval.clv >> /var/log/clv.log 2>&1

# Resumen semanal publico, lunes 09:00 UTC. Se publica SIEMPRE.
0 9 * * 1 cd /app && python -m qf.publish.weekly >> /var/log/weekly.log 2>&1

# Verificacion de integridad de la cadena, diaria.
0 6 * * * cd /app && python -m qf.publish.hashchain verify >> /var/log/chain.log 2>&1

# --- FASE 2 ---
# RETIRADO 2026-10-26 (titular: el Motor A se entrena en local y se sube con scripts/entrenamiento_local/; el servidor
# no entrena). Mensual y arranque quedan comentados; el chequeo diario avisa si el modelo pasa de 45 días.
# RETIRADO 2026-10-26: 0 3 1 * * cd /app && python -m qf.model.train >> /var/log/train.log 2>&1
# RETIRADO 2026-10-26: 5 1 2-31 * * cd /app && python -m qf.model.train --bootstrap >> /var/log/train.log 2>&1

# Conversions API de Meta (db/071 y db/083): envia la cola meta_events. Sin META_CAPI_ENABLED=1 no hace nada.
# El entorno del worker se fijo al crearlo: las variables de Meta se leen de /app/meta.env si existe.
*/5 * * * * cd /app && set -a && { [ ! -f /app/meta.env ] || . /app/meta.env; } && set +a && flock -n /tmp/meta_capi.lock python -m qf.comercial.meta_capi >> /var/log/meta_capi.log 2>&1

# Captura recurrente de FotMob (db/081), autorizada el 18-oct-2026 y reactivada el 25-oct como complemento diario de
# SofaScore y PropLine, solo en las competiciones activas. Una sola a la vez (flock); un bloqueo HTTP 401/403/429
# la detiene 12 h. Referencias de partidos una vez al día; instantáneas previas (24 h, 4 h, 70, 40 y 30 min antes)
# cada 5 min; archivo de partidos terminados cada hora; y cada hora, a :50 y sin peticiones, `completar` rellena en
# `matches` las estadísticas vacías (córners, tarjetas, tiros...) con la página ya guardada; el xG sigue su regla propia
# (página de ≥ 20 h y partido de más de 36 h).
50 5 * * * cd /app && flock -n /tmp/fotmob_captura.lock python -m qf.ingest.fotmob_captura referencias >> /var/log/fotmob_captura.log 2>&1
*/5 * * * * cd /app && flock -n /tmp/fotmob_captura.lock python -m qf.ingest.fotmob_captura previos >> /var/log/fotmob_captura.log 2>&1
35 * * * * cd /app && flock -n /tmp/fotmob_captura.lock python -m qf.ingest.fotmob_captura posteriores >> /var/log/fotmob_captura.log 2>&1
50 * * * * cd /app && flock -n /tmp/fotmob_captura.lock python -m qf.ingest.fotmob_captura completar >> /var/log/fotmob_captura.log 2>&1
# Resultados con la primera fuente que los tenga (titular, 25-oct-2026): `qf.ingest.live` cierra al pitido con FotMob.
# Este respaldo, cada hora, cierra lo que siga abierto a las 2 h 30 min del saque (enfriamiento, fuera del listado) si
# terminó en el tiempo reglamentario y con los mismos dos equipos; después liquida.
55 * * * * cd /app && flock -n /tmp/fotmob_captura.lock python -m qf.ingest.fotmob_captura resultados >> /var/log/fotmob_captura.log 2>&1

# Clima histórico ERA5 de los partidos ya jugados (db/082), incremental: solo pide a Copernicus lo que aún no cubren
# los archivos guardados (Copernicus publica con ~7 días de retraso). Necesita CDS_API_TOKEN en el entorno.
20 6 * * * cd /app && flock -n /tmp/era5.lock python -m qf.ingest.era5_clima >> /var/log/era5_clima.log 2>&1

# Sede de los partidos nuevos desde la página de FotMob (sin duplicar estadios) y altitud de los estadios nuevos.
50 * * * * cd /app && python -m qf.ingest.sedes >> /var/log/sedes.log 2>&1
