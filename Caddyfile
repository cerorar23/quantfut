# Caddy vive detrás del proxy de Cloudflare (SSL "Full (strict)").
# - La IP del cliente sale de CF-Connecting-IP, solo si la petición llega
#   desde un rango de Cloudflare. Rangos: https://www.cloudflare.com/ips
#   (copiados el 2026-09-24; el firewall del host usa la misma lista).
# - El certificado es el Origin Certificate de Cloudflare montado desde el
#   host; Caddy no pide certificados a Let's Encrypt.
# - /admin, /control y panel. los protege Cloudflare Access. Aquí solo se
#   exige que la petición traiga su JWT: sin él, Access no se aplicó.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(origen) {
	tls /etc/ssl/quantfut/origin.pem /etc/ssl/quantfut/origin.key
	header Strict-Transport-Security "max-age=31536000"
}

(api) {
	@sin_access {
		path /admin /admin/* /control /control/*
		not header Cf-Access-Jwt-Assertion *
	}
	respond @sin_access 404
	# main.py limita por el primer elemento de X-Forwarded-For.
	reverse_proxy api:8000 {
		header_up X-Forwarded-For {client_ip}
	}
}

api.{$DOMAIN} {
	import origen
	import api
}

{$DOMAIN}, www.{$DOMAIN} {
	import origen
	import api
}

panel.{$DOMAIN} {
	import origen
	@sin_access not header Cf-Access-Jwt-Assertion *
	respond @sin_access 404
	reverse_proxy grafana:3000
}
